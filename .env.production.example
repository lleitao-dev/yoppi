# Deployment metadata
YOPPI_DOMAIN=yoppi.example.com
YOPPI_REGISTRY=ghcr.io/your-github-user-or-org
YOPPI_VERSION=v0.9.0

# Runtime
NODE_ENV=production
SERVER_PORT=4000
DATABASE_URL=postgresql://user:password@managed-postgres.example.com:5432/yoppi?sslmode=require
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
WEB_ORIGIN=https://yoppi.example.com
LOG_LEVEL=info
TRUST_PROXY=true

# Abuse controls
HTTP_RATE_LIMIT_MAX=240
HTTP_RATE_LIMIT_WINDOW_MS=60000
SOCKET_RATE_LIMIT_MAX=120
SOCKET_RATE_LIMIT_WINDOW_MS=10000
BODY_LIMIT_BYTES=32768

# Lifecycle
SHUTDOWN_GRACE_MS=10000
ROOM_MINIMUM_PLAYER_GRACE_MS=15000
POKER_TURN_TIMEOUT_MS=30000
PLAYER_RECONNECT_TIMEOUT_MS=60000
