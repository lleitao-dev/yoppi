{
  "name": "@yoppi/server",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --format esm --clean --sourcemap",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "6.2.1",
    "fastify": "5.2.1",
    "zod": "3.24.1",
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "10.0.1",
    "@yoppi/protocol": "workspace:*",
    "socket.io": "4.8.1",
    "@yoppi/game-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.10.10",
    "prisma": "6.2.1",
    "tsup": "8.3.6",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
