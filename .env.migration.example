# One-shot PostgreSQL migration credential.
#
# This credential may own/alter the Yoppi schema and MUST NOT be exposed to
# the long-running API container. The deployment host keeps the real value in
# /opt/yoppi/.env.migration with mode 0600.
DATABASE_URL=postgresql://migration-user:password@managed-postgres.example.com:5432/yoppi?sslmode=require
