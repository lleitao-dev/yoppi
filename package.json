{
  "name": "yoppi",
  "version": "0.11.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @yoppi/web --filter @yoppi/server dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "prisma:generate": "pnpm --filter @yoppi/server prisma:generate",
    "prisma:migrate:dev": "pnpm --filter @yoppi/server prisma:migrate:dev",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@playwright/test": "1.55.1",
    "eslint": "9.17.0",
    "globals": "15.14.0",
    "prettier": "3.4.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.22.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.23",
      "sharp": "0.35.4",
      "vite": "6.4.3",
      "fast-uri@^3.0.0": "3.1.6",
      "fast-uri@^4.0.0": "4.1.3",
      "js-yaml": "4.3.2"
    }
  }
}
